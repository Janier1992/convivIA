# ============================================================
# InsForge (frontend — Vite, prefijo VITE_ obligatorio)
# ============================================================
VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=

# Clave pública VAPID para notificaciones push (ver sección VAPID más abajo).
# Es seguro exponerla en el frontend: es la mitad pública del par de claves.
VITE_VAPID_PUBLIC_KEY=

# ============================================================
# InsForge (compute service — server/, y Edge Functions vía `secrets add`)
# INSFORGE_API_KEY es una clave admin de proyecto completo (equivalente a
# la service role key de otras plataformas): NUNCA exponerla al frontend.
# ============================================================
INSFORGE_URL=
INSFORGE_API_KEY=

# ============================================================
# OpenAI
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Opcional: endpoint compatible con la API de OpenAI (ej. OpenRouter) para
# desarrollo local sin una key propia de OpenAI. Dejar vacío en producción.
OPENAI_BASE_URL=

# ============================================================
# Telegram — CANAL RECOMENDADO PARA ARRANCAR SIN COSTO. No requiere ninguna
# variable de entorno acá: cada organización conecta su propio bot token
# (creado gratis con @BotFather) desde el dashboard, vía la Edge Function
# telegram-connect, y el compute service lo atiende automáticamente con
# long-polling (sin necesitar URL pública ni webhook).
# ============================================================

# ============================================================
# Twilio (WhatsApp) — opcional, tiene costo (Twilio + WhatsApp Business
# Platform de Meta cobran por conversación). Usados sólo por el compute
# service para validar la firma entrante; las credenciales por organización
# se guardan en la tabla integrations vía las Edge Functions
# twilio-connect/twilio-disconnect.
# ============================================================
TWILIO_VALIDATE_SIGNATURE=true

# ============================================================
# Google OAuth / Calendar
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3011/api/integrations/google/callback

# ============================================================
# Notificaciones push (Web Push + VAPID) — opcional: si se deja vacío, la
# app funciona igual pero sin poder mandar notificaciones. Generar el par
# de claves una sola vez con:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY debe ser IDÉNTICA a VITE_VAPID_PUBLIC_KEY de arriba (son
# las dos mitades del mismo par: la pública va también al frontend, la
# privada NUNCA).
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.com

# ============================================================
# Aplicación
# ============================================================
APP_URL=http://localhost:5173
API_URL=http://localhost:3011
PORT=3011

# Timezone por defecto para nuevas organizaciones
DEFAULT_TIMEZONE=America/Bogota

# Entorno
NODE_ENV=development

# Secreto usado para firmar/verificar el `state` del flujo OAuth de Google
# (CSRF). Debe configurarse IDÉNTICO como secreto de InsForge
# (OAUTH_STATE_SECRET) para que la Edge Function google-oauth-start y el
# compute service (que verifica el callback) firmen/validen con la misma clave.
OAUTH_STATE_SECRET=change-me-in-production
